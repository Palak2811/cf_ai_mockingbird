{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mockingbird",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/agents/*", "/api/*"] },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "PrepAgent", "class_name": "PrepAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PrepAgent"] }],
  "workflows": [
    { "name": "prep-workflow", "binding": "PREP_WORKFLOW", "class_name": "PrepWorkflow" }
  ],
  "observability": { "enabled": true }
}
